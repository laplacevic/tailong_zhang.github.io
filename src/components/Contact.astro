---
import { profile } from "../data/profile";

const links = [
  { label: "ORCID", href: profile.links.orcid },
  { label: "GitHub", href: profile.links.github },
];
---

<section id="contact" class="panel">
  <div class="shell">
    <div class="panel-head reveal">
      <span class="panel-no">05</span>
      <h2 class="panel-title">Contact</h2>
    </div>
    <p class="invite reveal">
      Get in <em>touch.</em>
    </p>
    <p class="email reveal">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <ul class="links reveal">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .invite {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 300;
    max-width: none;
  }

  .invite em {
    color: var(--accent);
  }

  .email {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  .links {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: flex;
    gap: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
