---
// Schematic transmission spectrum: transit depth vs wavelength, with
// absorption features labelled for the minor molecules Tailong works on.
// Decorative; the figure caption marks it as a schematic.
---

<figure class="spectrum">
  <svg
    viewBox="0 0 1000 260"
    role="img"
    aria-label="Schematic transmission spectrum with absorption features labelled NH3, H2S and SO2"
  >
    <!-- spectrum curve -->
    <path
      class="curve"
      pathLength="1000"
      d="M 60 185
         C 100 183, 130 150, 165 148
         C 200 146, 215 180, 250 182
         C 275 183, 280 140, 310 138
         C 340 136, 350 178, 385 180
         C 415 182, 425 145, 455 142
         C 490 139, 510 176, 545 178
         C 580 180, 600 168, 630 158
         C 655 150, 665 165, 690 150
         C 700 120, 715 115, 725 130
         C 740 155, 760 178, 800 182
         C 840 186, 880 184, 940 186"
    ></path>

    <!-- wavelength axis -->
    <g class="axis">
      <line x1="60" y1="212" x2="940" y2="212"></line>
      {
        [1, 2, 3, 4, 5].map((um) => {
          const x = 60 + ((um - 0.8) / 4.4) * 880;
          return (
            <>
              <line x1={x} y1="212" x2={x} y2="219" />
              <text x={x} y="238" text-anchor="middle">
                {um}
              </text>
            </>
          );
        })
      }
      <text x="500" y="258" text-anchor="middle">wavelength (&#181;m)</text>
      <text x="38" y="180" text-anchor="middle" transform="rotate(-90 38 180)">
        transit depth
      </text>
    </g>

    <!-- molecule annotations -->
    <g class="labels">
      <text x="310" y="122" text-anchor="middle">
        NH<tspan dy="4" font-size="11">3</tspan>
      </text>
      <text x="640" y="138" text-anchor="middle">
        H<tspan dy="4" font-size="11">2</tspan><tspan dy="-4">S</tspan>
      </text>
      <text x="716" y="99" text-anchor="middle">
        SO<tspan dy="4" font-size="11">2</tspan>
      </text>
    </g>

    <!-- hover crosshair: matplotlib-style wavelength readout -->
    <g class="cross" aria-hidden="true">
      <line class="cross-line" x1="500" x2="500" y1="66" y2="212"></line>
      <text class="cross-text" x="500" y="52" text-anchor="middle"></text>
    </g>
  </svg>
  <figcaption class="mono muted">
    Fig. 1: a transmission spectrum (schematic).
  </figcaption>
</figure>

<style>
  .spectrum {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .curve {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw 2200ms var(--ease-out-expo) 600ms forwards;
  }

  .axis line {
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  .axis text,
  .labels text {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink-muted);
  }

  .labels text {
    fill: var(--accent);
  }

  .cross {
    opacity: 0;
    transition: opacity 200ms var(--ease-out-expo);
    pointer-events: none;
  }

  .cross.on {
    opacity: 1;
  }

  .cross-line {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  .cross-text {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    svg {
      cursor: crosshair;
    }
  }

  .axis,
  .labels {
    opacity: 0;
    animation: fade 900ms var(--ease-out-expo) forwards;
  }

  .axis {
    animation-delay: 1400ms;
  }

  .labels {
    animation-delay: 2400ms;
  }

  figcaption {
    margin-top: 0.75rem;
    opacity: 0;
    animation: fade 900ms var(--ease-out-expo) 2700ms forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curve {
      stroke-dashoffset: 0;
      animation: none;
    }

    .axis,
    .labels,
    figcaption {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  // Wavelength readout that follows the cursor, like a matplotlib figure.
  const svg = document.querySelector<SVGSVGElement>(".spectrum svg");
  const cross = svg?.querySelector<SVGGElement>(".cross");
  const line = svg?.querySelector<SVGLineElement>(".cross-line");
  const text = svg?.querySelector<SVGTextElement>(".cross-text");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");

  const molecules: Array<[number, number, string]> = [
    [275, 345, "NH₃"],
    [595, 665, "H₂S"],
    [686, 746, "SO₂"],
  ];

  if (svg && cross && line && text && fine.matches) {
    svg.addEventListener("pointermove", (e) => {
      const rect = svg.getBoundingClientRect();
      const x = Math.min(
        940,
        Math.max(60, ((e.clientX - rect.left) / rect.width) * 1000),
      );
      const um = 0.8 + ((x - 60) / 880) * 4.4;
      const mol = molecules.find(([a, b]) => x >= a && x <= b)?.[2];
      line.setAttribute("x1", String(x));
      line.setAttribute("x2", String(x));
      text.setAttribute("x", String(Math.min(870, Math.max(130, x))));
      text.textContent = `λ = ${um.toFixed(2)} µm${mol ? ` · ${mol}` : ""}`;
      cross.classList.add("on");
    });
    svg.addEventListener("pointerleave", () => cross.classList.remove("on"));
  }
</script>
