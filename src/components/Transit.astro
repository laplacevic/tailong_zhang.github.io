---
// Fig. 2: transit geometry with a synchronised light curve. The planet
// crosses the stellar disk while the flux curve draws itself in step.
// Plays once when scrolled into view; click replays.
---

<figure class="transit reveal" id="transit-fig">
  <svg
    viewBox="0 0 1000 300"
    role="img"
    aria-label="Animated schematic of a planetary transit: a planet with a thin atmosphere crosses its star while the measured stellar flux dips"
  >
    <!-- transit geometry: planet plus its atmosphere -->
    <circle class="star" cx="170" cy="130" r="80"></circle>
    <g class="body">
      <circle class="atm" cx="60" cy="130" r="16"></circle>
      <circle class="planet" cx="60" cy="130" r="10"></circle>
    </g>

    <!-- graph-paper grid under the light-curve plot -->
    <defs>
      <pattern
        id="grid-transit"
        width="22"
        height="22"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M 22 0 H 0 V 22"
          fill="none"
          style="stroke: var(--rule); stroke-width: 1;"></path>
      </pattern>
    </defs>
    <rect class="grid" x="380" y="70" width="560" height="170" fill="url(#grid-transit)"
    ></rect>

    <!-- light curve axes -->
    <g class="axis">
      <line x1="380" y1="240" x2="940" y2="240"></line>
      <line x1="380" y1="240" x2="380" y2="70"></line>
      <text x="660" y="266" text-anchor="middle">time</text>
      <text
        x="358"
        y="155"
        text-anchor="middle"
        transform="rotate(-90 358 155)">relative flux</text
      >
    </g>

    <!-- light curve: contact points match the planet's path across the disk -->
    <path
      class="lightcurve"
      pathLength="1000"
      d="M 380 100 L 431 100 L 482 145 L 838 145 L 889 100 L 940 100"
    ></path>
    <text class="depth" x="660" y="175" text-anchor="middle">transit</text>
  </svg>
  <figcaption class="mono muted">
    Fig. 3: then we observe it. The planet transits; starlight filters
    through its atmosphere and dims.
    <span class="hint">(click to replay)</span>
  </figcaption>
</figure>

<style>
  .transit {
    margin: clamp(3.5rem, 7vw, 6rem) auto 0;
    max-width: 680px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
  }

  .star {
    /* section behind it alternates to paper-deep, so the disk uses paper */
    fill: var(--paper);
    stroke: var(--ink-muted);
    stroke-width: 1.5;
  }

  .grid {
    opacity: 0.55;
  }

  .planet {
    fill: var(--ink);
  }

  .atm {
    fill: var(--accent);
    opacity: 0.25;
  }

  .axis line {
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  .axis text,
  .depth {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink-muted);
  }

  .depth {
    fill: var(--accent);
    opacity: 0;
  }

  .lightcurve {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }

  .transit.run .body {
    animation: cross 6000ms linear 300ms forwards;
  }

  .transit.run .lightcurve {
    animation: draw 6000ms linear 300ms forwards;
  }

  .transit.run .depth {
    animation: fade 700ms var(--ease-out-expo) 3300ms forwards;
  }

  figcaption {
    margin-top: 0.75rem;
  }

  @keyframes cross {
    to {
      transform: translateX(220px);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const fig = document.getElementById("transit-fig");
  if (fig) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            fig.classList.add("run");
            observer.unobserve(fig);
          }
        }
      },
      { threshold: 0.4 },
    );
    observer.observe(fig);
    fig.addEventListener("click", () => {
      fig.classList.remove("run");
      void fig.getBoundingClientRect().width;
      fig.classList.add("run");
    });
  }
</script>
